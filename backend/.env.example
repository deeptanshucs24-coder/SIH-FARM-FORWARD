# Database
DATABASE_URL=postgresql://farmforward_user:farmforward_pass@localhost:5432/farmforward

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Downstream service URLs (M4 = price prediction, M5 = market recommendation)
# Point these at localhost stubs until M4/M5 deploy their real services.
ML_SERVICE_URL=http://localhost:8001
RANKING_SERVICE_URL=http://localhost:8002

# App
ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
