# Database - matches M3's schema.sql/README_M3.md convention exactly
# (dbname "mandisetu", pgcrypto extension required for gen_random_uuid())
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mandisetu

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Downstream service URLs (M4 = price prediction, M5 = market recommendation)
ML_SERVICE_URL=http://localhost:8001
RANKING_SERVICE_URL=http://localhost:8002

# App
ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
